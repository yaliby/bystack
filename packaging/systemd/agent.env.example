# /etc/bystack/agent.env -- the agent's whole configuration.
#
# There is no config file for the agent and there will not be one. It is
# installed by copying a single binary onto a machine, and a file to manage
# alongside it would be a second thing to deploy for no gain (`agent/src/
# main.rs`). Flags and environment, and this is the environment.
#
# Install it 0600 root:root. It holds a join token, briefly.

# Where the Controller is. `wss://` only -- there is no insecure mode, no flag
# and no scheme for one, and the agent refuses `ws://` with the reason.
#
# The name here has to be one of `agents.server_names` on the Controller, or
# the certificate will not verify and the agent will say so.
BYSTACK_CONTROLLER=wss://controller.example:8443

# The join token, for the first run only.
#
# Mint one in the dashboard ("Add a host") or with
# `bystack-ctl token`. It is single-use and expires in minutes.
#
# **Spent, not secret, after the first successful connection.** The agent
# enrols once, writes a certificate into its state directory, and from then on
# this line does nothing -- except that a token left here alongside a stored
# certificate means *re-enrol*, which is deliberate and is what you want after
# rebuilding a host. `scripts/install-agent.sh` removes the line once the
# agent has a certificate, so an ordinary install does not leave one lying
# about.
BYSTACK_TOKEN=

# The engine to observe. The default, listed because it is the one thing here
# that legitimately differs on a machine -- a rootless daemon puts its socket
# under $XDG_RUNTIME_DIR, and the unit's User= must be able to read it.
BYSTACK_DOCKER_SOCKET=/var/run/docker.sock

# Refuse every mutation regardless of what the Controller sends. The second of
# the two choke points (ARCHITECTURE section 9): the Controller enforces
# `read_only` on its side, and an agent set here enforces it on its own
# authority for this host alone. Advertised at Hello, so the dashboard disables
# the actions rather than offering them and failing.
#BYSTACK_READ_ONLY=true

# Where the certificate lives. The unit sets this to match its StateDirectory=;
# changing one without the other is how an agent re-enrols on every restart.
#BYSTACK_STATE_DIR=/var/lib/bystack-agent
