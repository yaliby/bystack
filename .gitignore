# A real config, not the example one. It names ports, hostnames and a state
# directory for one machine; `bystack.example.yaml` is the tracked copy.
bystack.yaml

# The CA private key lives here by default (MIGRATION section 3).
.local/
state/

# What `compose.yaml` reads: the host's docker gid and, if it was widened, the
# bind address. One machine's answers, written by the install line in
# INSTALL.md -- there is nothing to check in.
.env

# Scratch from driving a real Controller by hand: throwaway configs, logs and
# a state directory with a CA key in it.
.bystack-test/
.bystack-test*.yaml

# Browser profile used by the local screenshot lab — cookies, history, locks.
.demo/lab/.chrome-profile/
